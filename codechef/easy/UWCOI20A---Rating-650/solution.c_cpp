#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;
    while(T--){
        int N;
        cin >> N;
        vector<int> arr(N);
        for(int i=0; i< N; i++){
            cin >> arr[i];
        }
        
        int maxn = INT_MIN;
    	for(int i=0; i< N; i++){
    	    if(arr[i] > maxn){
    	        maxn = arr[i];
	    }
	}
	cout << maxn << endl;
    }
	
	return 0;

}
