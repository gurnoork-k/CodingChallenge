#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;
    while(T--){
        int N;
    	cin >> N;
    	int K;
    	cin >> K;
    	vector<int> arr(N);
    	
    	for(int i=0; i< N; i++){
    	    cin >> arr[i];
    	}
    	
    	int c = 0;
    	for(int i=0 ; i < N; i++){
    	    if(arr[i] > K){
    	        c += 1;
    	    }
    	}
    	cout << c << endl;
    }
}
