#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int> arr(n) ;;
        for(int i=0;i<n;i++){
            cin>>arr[i];
        }
        sort(arr.begin(), arr.end());
        
        int num1 = arr[n-1];
        int num2 = -1;
        
        for(int i=n-2; i >=0; i-- ){
            if(arr[i] != num1){
                num2 = arr[i];
                break;
            }
        }
        
        int ans = num1 + num2;
        cout << ans << endl;
    
    }
    return 0;
}
